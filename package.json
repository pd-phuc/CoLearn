    "lint-staged": "^16.0.0",
    "prettier": "^3.8.0",
    "prettier-plugin-blade": "^2.1.21",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  }
